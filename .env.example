# 复制此文件为 .env 并填入你的真实 Key（.env 已被 .gitignore 排除，不会入库）
# 通义千问 OpenAI 兼容模式接入
DASHSCOPE_API_KEY=你的通义千问APIKey

# API 地址（二选一，按你的 Key 来源填写）：
# 千问 AI 平台创建的 Key（https://maas.qianwenaiapi.com）：
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# 阿里云百炼/DashScope 创建的 Key（默认值，可删掉上一行）：
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（可选，默认 qwen-plus）
# QWEN_MODEL=qwen-plus
